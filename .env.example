# Public URL of the app. Used for auth callbacks, the WebSocket origin check and share-image links.
SITE_URL=http://localhost:3000

DATABASE_URL=

# Signs session cookies.
BETTER_AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
EMAIL_FROM=ponoc <noreply@ponoc.tech>

DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Each model's price travels with it: USD per 1M tokens, from the provider's pricing page.
TRIAGE_MODEL=gpt-5.4-nano
TRIAGE_INPUT_USD_PER_M=0.20
TRIAGE_OUTPUT_USD_PER_M=1.25

VERIFY_MODEL=gpt-5.4-mini
VERIFY_INPUT_USD_PER_M=0.75
VERIFY_OUTPUT_USD_PER_M=4.50

# OpenAI's fee per web search, and Deepgram's streaming price per minute.
WEB_SEARCH_USD=0.01
DEEPGRAM_USD_PER_MIN=0.0077

PORT=3000
